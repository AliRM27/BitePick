{
  "expo": {
    "name": "CupMap",
    "slug": "bitepick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitepick",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/bitePickerIcon.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CupMap needs your location to find nearby restaurants.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "de",
          "fr",
          "it",
          "es",
          "ru",
          "ja",
          "ko",
          "pt",
          "zh"
        ]
      },
      "bundleIdentifier": "com.alirm.bitepick",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.alirm.bitepick",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CupMap needs your location to find the best restaurants near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F0",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./withFirebasePods.js",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b521976c-4f4c-4c35-8b6f-4b9ffa2f259a"
      }
    },
    "owner": "alirm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b521976c-4f4c-4c35-8b6f-4b9ffa2f259a"
    }
  }
}